# OpenClaw 项目忽略规则

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node / 前端
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# 本地配置
.env
.env.*
*.local
*.local.json

# 日志
logs/
*.log
*.err.log
*.out.log

# 运行生成数据
backend/uploads/
backend/outputs/
backend/data/*.db

# 缓存 / 临时
.codex_tmp/
.cache/
tmp/
temp/
*.tmp
*.bak
.playwright-cli/
backend/tmp_*.png

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
